{
  "name": "whatsapp-status-bot",
  "version": "1.0.0",
  "description": "Personal WhatsApp automation bot - saves contacts and sends vCard reply",
  "main": "dist/index.js",
  "scripts": {
    "postinstall": "node scripts/patch-baileys-prelogin-ack.js",
    "build": "tsc",
    "test:service-bot": "npm run build && node scripts/test-service-bot-flow.js && node scripts/test-service-bot-ui.js",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "measure:whatsapp-memory": "node scripts/measure-whatsapp-memory.js",
    "test:flow-recovery": "npm run build && node scripts/test-flow-recovery.js",
    "test:flow-concurrency": "npm run build && node scripts/test-flow-concurrency.js",
    "db:migrate": "node scripts/migrate-json-to-postgres.js",
    "db:migrate:apply": "node scripts/migrate-json-to-postgres.js --apply",
    "db:migrate:force": "node scripts/migrate-json-to-postgres.js --apply --force",
    "db:export": "node scripts/export-postgres-to-json.js",
    "test:outbox-durability": "npm run build && node scripts/test-outbox-durability.js",
    "test:postgres-delta": "npm run build && node scripts/test-postgres-delta.js",
    "test:meta-gateway-inbox": "npm run build && node scripts/test-meta-gateway-inbox.js",
    "test:meta-media-cache": "npm run build && node scripts/test-meta-media-cache.js",
    "test:message-delays": "npm run build && node scripts/test-message-delays.js",
    "test:outbox-claim": "npm run build && node scripts/test-outbox-claim.js",
    "test:outbox-ordering": "npm run build && node scripts/test-outbox-ordering.js",
    "test:migration-safety": "npm run build && node scripts/test-migration-safety.js",
    "test:postgres-migration-pilot": "node scripts/test-postgres-migration-pilot.js",
    "test:postgres-burst": "npm run build && node scripts/test-postgres-burst.js",
    "test:dokploy-provisioner": "npm run build && node scripts/test-dokploy-provisioner-postgres.js",
    "test:provider-health": "npm run build && node scripts/test-provider-health.js",
    "test:client-disable": "npm run build && node scripts/test-client-disable.js",
    "test:vcard-export": "npm run build && node scripts/test-vcard-export.js",
    "test:referral-ranking": "npm run build && node scripts/test-referral-ranking.js",
    "test:group-join-flow": "npm run build && node scripts/test-group-join-flow.js",
    "test:score-result-preface": "npm run build && node scripts/test-score-result-preface.js",
    "test:email-capture": "npm run build && node scripts/test-email-capture.js && node scripts/test-email-export.js",
    "test:whatsapp-links": "npm run build && node scripts/test-whatsapp-link-normalization.js",
    "test:meta-webhook-signature": "npm run build && node scripts/test-meta-webhook-signature.js",
    "test:graceful-shutdown": "npm run build && node scripts/test-graceful-shutdown.js",
    "test:campaign-delete-conversations": "npm run build && node scripts/test-campaign-delete-conversations.js"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "googleapis": "^140.0.0",
    "open": "^8.4.2",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "^1.23.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
